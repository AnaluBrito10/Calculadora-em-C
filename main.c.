
#include <stdio.h>

int main() {
    int opcao;
    float n1, n2;
    char continuar;
    char entrada[50];
    char extra;

    do {
        printf("===============================\n");
        printf("   Calculadora Simples\n");
        printf("===============================\n");
        printf("1. Adicao\n");
        printf("2. Subtracao\n");
        printf("3. Multiplicacao\n");
        printf("4. Divisao\n");
        printf("5. Sair\n");

        do {
            printf("Opcao: ");
            fgets(entrada, 50, stdin);

            if (sscanf(entrada, "%d %c", &opcao, &extra) != 1 || opcao < 1 || opcao > 5) {
                printf("Opcao invalida!\n");
                opcao = 0;
            }

        } while (opcao == 0);

        if (opcao == 5) {
            break;
        }

        printf("Digite o primeiro numero: ");
        scanf("%f", &n1);

        printf("Digite o segundo numero: ");
        scanf("%f", &n2);

        getchar();

        if (opcao == 1) {
            printf("Resultado: %.2f + %.2f = %.2f\n", n1, n2, n1 + n2);
        }

        else if (opcao == 2) {
            printf("Resultado: %.2f - %.2f = %.2f\n", n1, n2, n1 - n2);
        }

        else if (opcao == 3) {
            printf("Resultado: %.2f * %.2f = %.2f\n", n1, n2, n1 * n2);
        }

        else if (opcao == 4) {
            if (n2 != 0) {
                printf("Resultado: %.2f / %.2f = %.2f\n", n1, n2, n1 / n2);
            } else {
                printf("Nao e possivel dividir por zero!\n");
            }
        }

        do {
            printf("Deseja realizar outra operacao? (s/n): ");
            fgets(entrada, 50, stdin);

            if (sscanf(entrada, " %c %c", &continuar, &extra) != 1 ||
                (continuar != 's' && continuar != 'S' &&
                 continuar != 'n' && continuar != 'N')) {
                printf("Resposta invalida! Digite s ou n.\n");
                continuar = 'x';
            }

        } while (continuar == 'x');

    } while (continuar == 's' || continuar == 'S');

    printf("Obrigado por usar a calculadora! Ate a proxima.\n");

    return 0;
}
