
#include <stdio.h>

int main() {
    int opcao;
    float n1, n2;
    char continuar;

    do {
        printf("===============================\n");
        printf("     Calculadora Simples\n");
        printf("===============================\n");
        printf("1. Adicao\n");
        printf("2. Subtracao\n");
        printf("3. Multiplicacao\n");
        printf("4. Divisao\n");
        printf("5. Sair\n");
        printf("Opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Opcao invalida!\n");

            while (getchar() != '\n');

            opcao = 0;
            continue;
        }

        if (opcao < 1 || opcao > 5) {
            printf("Opcao invalida!\n");
        }

        else if (opcao == 5) {
            printf("Obrigado por usar a calculadora! Ate a proxima.\n");
            break;
        }

        else {
            printf("Digite o primeiro numero: ");
            scanf("%f", &n1);

            printf("Digite o segundo numero: ");
            scanf("%f", &n2);

            if (opcao == 1) {
                printf("Resultado: %.2f + %.2f = %.2f\n", n1, n2, n1 + n2);
            }

            else if (opcao == 2) {
                printf("Resultado: %.2f - %.2f = %.2f\n", n1, n2, n1 - n2);
            }

            else if (opcao == 3) {
                printf("Resultado: %.2f * %.2f = %.2f\n", n1, n2, n1 * n2);
            }

            else if (opcao == 4) {
                if (n2 != 0) {
                    printf("Resultado: %.2f / %.2f = %.2f\n", n1, n2, n1 / n2);
                } else {
                    printf("Nao e possivel dividir por zero!\n");
                }
            }

            printf("Deseja realizar outra operacao? (s/n): ");
            scanf(" %c", &continuar);

            if (continuar != 's' && continuar != 'S') {
                printf("Obrigado por usar a calculadora! Ate a proxima.\n");
                break;
            }
        }

    } while (1);

    return 0;
}
